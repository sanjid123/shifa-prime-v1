rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Firestore security rules for SHIFA-PRIME HMS.
    // SECURE access rules: only authenticated users can read/write snapshots.
    
    match /snapshots/{document} {
      // TODO: Set to `if request.auth != null;` once Firebase Auth is wired.
      // During initial staging test, you can set to `if true;` temporarily.
      allow read, write: if request.auth != null;
    }
    
    match /history/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Global fallback: Deny read/write access to all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
