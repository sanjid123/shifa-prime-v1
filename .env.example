# Backend selection: "local" (offline / localStorage) or "firebase"
VITE_BACKEND=local

# Nightly cloud-sync hour (0-23). Admin UI can override at runtime.
VITE_SYNC_HOUR=22

# Firebase client config (only needed when VITE_BACKEND=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
